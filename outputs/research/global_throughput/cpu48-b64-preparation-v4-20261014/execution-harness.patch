+
+CONFLICTS = {"OMP_NUM_THREADS": "1", "OMP_THREAD_LIMIT": "1", "MKL_NUM_THREADS": "64",
+    "OPENBLAS_NUM_THREADS": "64", "NUMEXPR_NUM_THREADS": "64",
