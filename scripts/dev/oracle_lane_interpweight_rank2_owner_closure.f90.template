module interpol_help
  use constantes
  use grid
  use mod_orchidee_para
  use ioipsl_para, only: ipslerr_p
  implicit none
  logical, parameter :: check_grid = .false.
  integer, save :: aggregate_attempt_count = 0
  integer, allocatable, save :: aggregate_widths(:)
  integer(i_std), allocatable, save :: captured_mask(:,:), captured_index(:,:,:)
  real(r_std), allocatable, save :: captured_area(:,:)
  interface aggregate_p
    module procedure transport_aggregate_2d_p
  end interface
contains
  subroutine reset_aggregate_trace()
    aggregate_attempt_count = 0
    if (allocated(aggregate_widths)) deallocate(aggregate_widths)
    if (allocated(captured_mask)) deallocate(captured_mask)
    if (allocated(captured_index)) deallocate(captured_index)
    if (allocated(captured_area)) deallocate(captured_area)
    allocate(aggregate_widths(32))
    aggregate_widths = 0
  end subroutine reset_aggregate_trace

  subroutine transport_aggregate_2d_p(nbpt, lalo, neighbours, resolution, contfrac, &
       iml, jml, lon_ful, lat_ful, mask, callsign, nbvmax, sub_index, sub_area, ok)
    integer(i_std), intent(in) :: nbpt, iml, jml, nbvmax
    real(r_std), intent(in) :: lalo(nbpt,2), resolution(nbpt,2), contfrac(nbpt)
    integer(i_std), intent(in) :: neighbours(nbpt,NbNeighb), mask(iml,jml)
    real(r_std), intent(in) :: lon_ful(iml,jml), lat_ful(iml,jml)
    character(len=*), intent(in) :: callsign
    integer(i_std), intent(out) :: sub_index(nbpt,nbvmax,2)
    real(r_std), intent(out) :: sub_area(nbpt,nbvmax)
    logical, optional, intent(out) :: ok
    aggregate_attempt_count = aggregate_attempt_count + 1
    aggregate_widths(aggregate_attempt_count) = nbvmax
    call aggregate_2d(nbpt, lalo, neighbours, resolution, contfrac, iml, jml, &
         lon_ful, lat_ful, mask, callsign, nbvmax, sub_index, sub_area, ok)
    if (present(ok)) then
      if (ok) then
        if (allocated(captured_mask)) deallocate(captured_mask)
        if (allocated(captured_index)) deallocate(captured_index)
        if (allocated(captured_area)) deallocate(captured_area)
        allocate(captured_mask(iml,jml), captured_index(nbpt,nbvmax,2), &
                 captured_area(nbpt,nbvmax))
        captured_mask = mask
        captured_index = sub_index
        captured_area = sub_area
      end if
    end if
  end subroutine transport_aggregate_2d_p

! <AGGREGATE_2D>
end module interpol_help

