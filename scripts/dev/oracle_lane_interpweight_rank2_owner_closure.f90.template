module constantes_var
  implicit none
  integer, parameter :: i_std = selected_int_kind(9)
  integer, parameter :: r_std = selected_real_kind(12, 100)
  integer(i_std), parameter :: undef_int = 999999999_i_std
  real(r_std), parameter :: pi = 3.141592653589793238_r_std
  real(r_std), parameter :: zero = 0._r_std
  real(r_std), parameter :: un = 1._r_std
  real(r_std), parameter :: deux = 2._r_std
  real(r_std), parameter :: moins_un = -1._r_std
  real(r_std), parameter :: R_Earth = 6378000._r_std
  real(r_std), parameter :: mincos = 0.0001_r_std
  integer, save :: printlev = 0
  integer, save :: numout = 6
end module constantes_var

module constantes
  use constantes_var
  implicit none
end module constantes

module fixture_data
  use constantes_var
  implicit none
  integer, save :: fixture_id = 1
  integer, save :: fixture_rank = 2
  integer, save :: coord_rank = 1
  integer, save :: iml_fixture = 3
  integer, save :: jml_fixture = 3
  integer, save :: lml_fixture = 2
  integer, save :: tml_fixture = 2
  integer, save :: transport_i_count = 0
  integer, save :: transport_r2_count = 0
  real(r_std), allocatable, save :: values2(:,:), lon1(:), lat1(:)
  real(r_std), allocatable, save :: lon2(:,:), lat2(:,:), mask2(:,:)
contains
  subroutine reset_transport_counts()
    transport_i_count = 0
    transport_r2_count = 0
  end subroutine reset_transport_counts

  subroutine configure_fixture(case_id, rank_value)
    integer, intent(in) :: case_id, rank_value
    integer :: i, j
    fixture_id = case_id
    fixture_rank = rank_value
    if (allocated(values2)) deallocate(values2, lon2, lat2, mask2)
    if (allocated(lon1)) deallocate(lon1, lat1)
    if (case_id == 4) then
      iml_fixture = 16
      jml_fixture = 16
    else
      iml_fixture = 3
      jml_fixture = 3
    end if
    allocate(values2(iml_fixture,jml_fixture), lon2(iml_fixture,jml_fixture), &
             lat2(iml_fixture,jml_fixture), mask2(iml_fixture,jml_fixture))
    allocate(lon1(iml_fixture), lat1(jml_fixture))
    select case (case_id)
    case (1)
      coord_rank = 1
      lon1 = (/ 178.5_r_std, 179.5_r_std, 180.5_r_std /)
      lat1 = (/ -1._r_std, 0._r_std, 1._r_std /)
    case (2)
      coord_rank = 2
      lon1 = (/ -180.5_r_std, -179.5_r_std, -178.5_r_std /)
      lat1 = (/ -1._r_std, 0._r_std, 1._r_std /)
    case (3)
      coord_rank = 1
      lon1 = (/ -1._r_std, 0._r_std, 1._r_std /)
      lat1 = (/ -1._r_std, 0._r_std, 1._r_std /)
    case (4)
      coord_rank = 1
      do i = 1, 15
        lon1(i) = -0.7_r_std + real(i-1,r_std)*0.1_r_std
        lat1(i) = -0.7_r_std + real(i-1,r_std)*0.1_r_std
      end do
      lon1(16) = 5._r_std
      lat1(16) = 5._r_std
    case default
      coord_rank = 1
      lon1 = (/ -1._r_std, 0._r_std, 1._r_std /)
      lat1 = (/ -1._r_std, 0._r_std, 1._r_std /)
    end select
    do j = 1, jml_fixture
      do i = 1, iml_fixture
        lon2(i,j) = lon1(i)
        lat2(i,j) = lat1(j)
        values2(i,j) = real(mod(i + 2*j, 3) + 1, r_std)
        mask2(i,j) = merge(un, zero, mod(i+j,2) == 0)
      end do
    end do
    if (case_id == 2) values2(1,1) = -2._r_std
    if (case_id == 3) then
      values2(:,1) = (/ 1._r_std, 1._r_std, 1._r_std /)
      values2(:,2) = (/ 2._r_std, 3._r_std, 4._r_std /)
      values2(:,3) = (/ 3._r_std, 2._r_std, 1._r_std /)
    end if
  end subroutine configure_fixture
end module fixture_data

module netcdf
  use fixture_data
  implicit none
  integer, parameter :: NF90_NOWRITE = 0
  integer, parameter :: NF90_NOERR = 0
contains
  integer function nf90_open(filename, mode, nid)
    character(len=*), intent(in) :: filename
    integer, intent(in) :: mode
    integer, intent(out) :: nid
    nid = 11
    nf90_open = NF90_NOERR
  end function nf90_open

  integer function nf90_inq_varid(nid, varname, vid)
    integer, intent(in) :: nid
    character(len=*), intent(in) :: varname
    integer, intent(out) :: vid
    if (trim(varname) == 'lon' .or. trim(varname) == 'lat') then
      vid = 2
    else if (trim(varname) == 'mask') then
      vid = 3
    else
      vid = 1
    end if
    nf90_inq_varid = NF90_NOERR
  end function nf90_inq_varid

  integer function nf90_inquire_variable(nid, vid, ndims, dimids)
    integer, intent(in) :: nid, vid
    integer, intent(out), optional :: ndims
    integer, intent(out), optional :: dimids(:)
    integer :: rank_value, i
    if (vid == 2) then
      rank_value = coord_rank
    else
      rank_value = fixture_rank
    end if
    if (present(ndims)) ndims = rank_value
    if (present(dimids)) then
      do i = 1, size(dimids)
        dimids(i) = i
      end do
    end if
    nf90_inquire_variable = NF90_NOERR
  end function nf90_inquire_variable

  integer function nf90_inquire_dimension(nid, dimid, len)
    integer, intent(in) :: nid, dimid
    integer, intent(out), optional :: len
    if (present(len)) then
      select case (dimid)
      case (1)
        len = iml_fixture
      case (2)
        len = jml_fixture
      case (3)
        len = lml_fixture
      case default
        len = tml_fixture
      end select
    end if
    nf90_inquire_dimension = NF90_NOERR
  end function nf90_inquire_dimension

  integer function nf90_close(nid)
    integer, intent(in) :: nid
    nf90_close = NF90_NOERR
  end function nf90_close

  character(len=32) function nf90_strerror(rcode)
    integer, intent(in) :: rcode
    nf90_strerror = 'fixture netcdf status'
  end function nf90_strerror
end module netcdf

module ioipsl
  use fixture_data
  implicit none
  interface flinget
    module procedure flinget_r1, flinget_r2, flinget_r3, flinget_r4
  end interface
contains
  subroutine fliodmpf(filename)
    character(len=*), intent(in) :: filename
  end subroutine fliodmpf

  subroutine flioopfd(filename, fid, nb_dim, nb_var, nb_gat)
    character(len=*), intent(in) :: filename
    integer, intent(out) :: fid
    integer, intent(out), optional :: nb_dim, nb_var, nb_gat
    fid = 11
    if (present(nb_dim)) nb_dim = 3
    if (present(nb_var)) nb_var = 4
    if (present(nb_gat)) nb_gat = 0
  end subroutine flioopfd

  subroutine flininfo(filename, iml, jml, lml, tml, fid)
    character(len=*), intent(in) :: filename
    integer, intent(out) :: iml, jml, lml, tml, fid
    iml = iml_fixture
    jml = jml_fixture
    lml = lml_fixture
    tml = tml_fixture
    fid = 11
  end subroutine flininfo

  subroutine flinclo(fid)
    integer, intent(in) :: fid
  end subroutine flinclo

  subroutine flinget_r1(fid, varname, d1, d2, d3, d4, first, count, output)
    integer, intent(in) :: fid, d1, d2, d3, d4, first, count
    character(len=*), intent(in) :: varname
    real(r_std), intent(out) :: output(d1)
    if (trim(varname) == 'lon') then
      output = lon1
    else
      output = lat1
    end if
  end subroutine flinget_r1

  subroutine flinget_r2(fid, varname, d1, d2, d3, d4, first, count, output)
    integer, intent(in) :: fid, d1, d2, d3, d4, first, count
    character(len=*), intent(in) :: varname
    real(r_std), intent(out) :: output(d1,d2)
    select case (trim(varname))
    case ('lon')
      output = lon2
    case ('lat')
      output = lat2
    case ('mask')
      output = mask2
    case default
      output = values2
    end select
  end subroutine flinget_r2

  subroutine flinget_r3(fid, varname, d1, d2, d3, d4, first, count, output)
    integer, intent(in) :: fid, d1, d2, d3, d4, first, count
    character(len=*), intent(in) :: varname
    real(r_std), intent(out) :: output(d1,d2,d3)
    integer :: k
    do k = 1, d3
      output(:,:,k) = values2
    end do
  end subroutine flinget_r3

  subroutine flinget_r4(fid, varname, d1, d2, d3, d4, first, count, output)
    integer, intent(in) :: fid, d1, d2, d3, d4, first, count
    character(len=*), intent(in) :: varname
    real(r_std), intent(out) :: output(d1,d2,d3,d4)
    integer :: k, l
    do l = 1, d4
      do k = 1, d3
        output(:,:,k,l) = values2
      end do
    end do
  end subroutine flinget_r4
end module ioipsl

module mod_orchidee_para
  use constantes_var
  use fixture_data
  implicit none
  logical, save :: is_root_prc = .true.
  integer, save :: mpi_rank = 0
  integer, save :: nbp_glo = 0
  integer, allocatable, save :: nbp_mpi_para_begin(:), nbp_mpi_para_end(:)
  real(r_std), allocatable, save :: lalo_g(:,:), resolution_g(:,:), contfrac_g(:)
  integer(i_std), allocatable, save :: neighbours_g(:,:)
  interface bcast
    module procedure bcast_i0, bcast_i1, bcast_i2, bcast_r1, bcast_r2, bcast_r3, bcast_r4, bcast_l0
  end interface
contains
  subroutine configure_parallel(lalo, resolution, neighbours, contfrac)
    real(r_std), intent(in) :: lalo(:,:), resolution(:,:), contfrac(:)
    integer(i_std), intent(in) :: neighbours(:,:)
    if (allocated(lalo_g)) deallocate(lalo_g, resolution_g, neighbours_g, contfrac_g)
    if (allocated(nbp_mpi_para_begin)) deallocate(nbp_mpi_para_begin, nbp_mpi_para_end)
    nbp_glo = size(lalo,1)
    allocate(lalo_g(nbp_glo,2), resolution_g(nbp_glo,2), &
             neighbours_g(nbp_glo,size(neighbours,2)), contfrac_g(nbp_glo))
    allocate(nbp_mpi_para_begin(0:0), nbp_mpi_para_end(0:0))
    lalo_g = lalo
    resolution_g = resolution
    neighbours_g = neighbours
    contfrac_g = contfrac
    nbp_mpi_para_begin(0) = 1
    nbp_mpi_para_end(0) = nbp_glo
  end subroutine configure_parallel
  subroutine bcast_i0(value)
    integer, intent(inout) :: value
    if (.not. is_root_prc) then
      transport_i_count = transport_i_count + 1
      select case (transport_i_count)
      case (1)
        value = fixture_rank
      case (2)
        value = iml_fixture
      case (3)
        value = jml_fixture
      case (4)
        value = coord_rank
      case (5)
        value = 200
      case default
        value = 3
      end select
    end if
  end subroutine bcast_i0
  subroutine bcast_i1(value)
    integer, intent(inout) :: value(:)
  end subroutine bcast_i1
  subroutine bcast_i2(value)
    integer, intent(inout) :: value(:,:)
  end subroutine bcast_i2
  subroutine bcast_r1(value)
    real(r_std), intent(inout) :: value(:)
  end subroutine bcast_r1
  subroutine bcast_r2(value)
    real(r_std), intent(inout) :: value(:,:)
    if (.not. is_root_prc) then
      transport_r2_count = transport_r2_count + 1
      select case (transport_r2_count)
      case (1)
        value = values2
      case (2)
        value = lon2
      case default
        value = lat2
      end select
    end if
  end subroutine bcast_r2
  subroutine bcast_r3(value)
    real(r_std), intent(inout) :: value(:,:,:)
  end subroutine bcast_r3
  subroutine bcast_r4(value)
    real(r_std), intent(inout) :: value(:,:,:,:)
  end subroutine bcast_r4
  subroutine bcast_l0(value)
    logical, intent(inout) :: value
  end subroutine bcast_l0
end module mod_orchidee_para

