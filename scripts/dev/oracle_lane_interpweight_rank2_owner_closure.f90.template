program oracle_interpweight_rank2_owner_closure
  use constantes_var
  use fixture_data
  use grid
  use interpweight
  use interpol_help
  use mod_orchidee_para
  implicit none
  character(len=128) :: mode, output_path
  integer :: unit
  call get_command_argument(1, mode)
  call get_command_argument(2, output_path)
  if (len_trim(mode) == 0) mode = 'valid'
  if (trim(mode) == 'valid') then
    open(newunit=unit, file=trim(output_path), status='replace', action='write')
    write(unit,'(A)') 'case,field,index,value'
    call run_fraction(unit, 'frac_east_nomask', 1, 'nomask', .false., .true., 179.75_r_std, 180000._r_std, 0)
    call run_fraction(unit, 'frac_west_var', 2, 'var', .true., .false., -179.75_r_std, 180000._r_std, 5)
    call run_fraction(unit, 'frac_boundary_mbelow', 3, 'mbelow', .false., .false., 30._r_std, 120000._r_std, 0)
    call run_fraction(unit, 'frac_mabove', 3, 'mabove', .false., .false., 0._r_std, 120000._r_std, 0)
    call run_fraction(unit, 'frac_msumrange', 3, 'msumrange', .false., .false., 0._r_std, 120000._r_std, 0)
    call run_fraction(unit, 'frac_dense_retry', 4, 'nomask', .false., .false., 0._r_std, 200000._r_std, 0)
    call run_fraction(unit, 'frac_large_capacity', 3, 'nomask', .false., .false., 0._r_std, 2000000._r_std, 0)
    call run_continuous(unit, 'cont_east_default', 1, 'nomask', 'default', .false., 179.75_r_std, 180000._r_std, 0)
    call run_continuous(unit, 'cont_west_slope_var', 2, 'var', 'slopecalc', .true., -179.75_r_std, 180000._r_std, 5)
    call run_continuous(unit, 'cont_boundary_mbelow', 3, 'mbelow', 'default', .false., 30._r_std, 120000._r_std, 0)
    call run_continuous(unit, 'cont_mabove', 3, 'mabove', 'default', .false., 0._r_std, 120000._r_std, 0)
    call run_continuous(unit, 'cont_msumrange', 3, 'msumrange', 'default', .false., 0._r_std, 120000._r_std, 0)
    call run_continuous(unit, 'cont_dense_retry', 4, 'nomask', 'default', .false., 0._r_std, 200000._r_std, 0)
    close(unit)
  else if (trim(mode) == 'coverage_success') then
    call run_coverage_success()
  else if (trim(mode) == 'coverage_nonroot') then
    call run_coverage_nonroot()
  else
    call run_contract_mode(trim(mode))
  end if
contains
  subroutine prepare_target(target_lon, target_resolution, lalo, resolution, neighbours, contfrac)
    real(r_std), intent(in) :: target_lon, target_resolution
    real(r_std), intent(out) :: lalo(2,2), resolution(2,2), contfrac(2)
    integer(i_std), intent(out) :: neighbours(2,NbNeighb)
    lalo(1,:) = (/ 0._r_std, target_lon /)
    lalo(2,:) = (/ 45._r_std, 90._r_std /)
    resolution = target_resolution
    neighbours = 0
    contfrac = (/ 0.75_r_std, 0.5_r_std /)
    call configure_parallel(lalo, resolution, neighbours, contfrac)
  end subroutine prepare_target

  subroutine run_fraction(unit, label, case_id, masktype, noneg, default_types, target_lon, target_resolution, level)
    integer, intent(in) :: unit, case_id, level
    character(len=*), intent(in) :: label, masktype
    logical, intent(in) :: noneg, default_types
    real(r_std), intent(in) :: target_lon, target_resolution
    real(r_std) :: lalo(2,2), resolution(2,2), contfrac(2), variabletypes(3)
    real(r_std) :: output(6), availability(2), maskvalues(3), varmin, varmax
    integer(i_std) :: neighbours(2,NbNeighb)
    character(len=80) :: filename, varname, lonname, latname
    character(len=250) :: maskvarname
    character(len=50) :: fraction_type, mask_type
    call configure_fixture(case_id, 2)
    call prepare_target(target_lon, target_resolution, lalo, resolution, neighbours, contfrac)
    call reset_aggregate_trace()
    printlev = level
    variabletypes = (/ 1._r_std, 2._r_std, 3._r_std /)
    if (default_types) variabletypes = -un
    maskvalues = (/ 1.5_r_std, 1._r_std, 5._r_std /)
    varmin = 1._r_std
    varmax = 3._r_std
    output = -999._r_std
    filename = 'fixture.nc'
    varname = 'soilcolor'
    lonname = 'lon'
    latname = 'lat'
    maskvarname = 'mask'
    fraction_type = 'default'
    mask_type = masktype
    call interpweight_2D(2, 3, variabletypes, lalo, resolution, neighbours, contfrac, &
         filename, varname, lonname, latname, varmin, varmax, noneg, mask_type, &
         maskvalues, maskvarname, 0, 0, -1, fraction_type, &
         merge(100000._r_std, -un, default_types), merge(100000._r_std, -un, default_types), &
         output, availability)
    call emit_real_vector(unit, label, 'output', output)
    call emit_real_vector(unit, label, 'availability', availability)
    call emit_real_vector(unit, label, 'source_values', reshape(values2, (/ size(values2) /)))
    call emit_real_vector(unit, label, 'source_lon', reshape(lon2, (/ size(lon2) /)))
    call emit_real_vector(unit, label, 'source_lat', reshape(lat2, (/ size(lat2) /)))
    call emit_trace(unit, label)
  end subroutine run_fraction

  subroutine run_continuous(unit, label, case_id, masktype, typefrac, noneg, target_lon, target_resolution, level)
    integer, intent(in) :: unit, case_id, level
    character(len=*), intent(in) :: label, masktype, typefrac
    logical, intent(in) :: noneg
    real(r_std), intent(in) :: target_lon, target_resolution
    real(r_std) :: lalo(2,2), resolution(2,2), contfrac(2)
    real(r_std) :: output(2), availability(2), maskvalues(3), varmin, varmax
    integer(i_std) :: neighbours(2,NbNeighb)
    character(len=80) :: filename, varname, lonname, latname
    character(len=250) :: maskvarname
    character(len=50) :: mask_type, fraction_type
    call configure_fixture(case_id, 2)
    call prepare_target(target_lon, target_resolution, lalo, resolution, neighbours, contfrac)
    call reset_aggregate_trace()
    printlev = level
    maskvalues = (/ 1.5_r_std, 1._r_std, 5._r_std /)
    varmin = 0._r_std
    varmax = 10._r_std
    filename = 'fixture.nc'
    varname = 'topography'
    lonname = 'lon'
    latname = 'lat'
    maskvarname = 'mask'
    mask_type = masktype
    fraction_type = typefrac
    call interpweight_2Dcont(2, 0, 0, lalo, resolution, neighbours, contfrac, &
         filename, varname, lonname, latname, varmin, varmax, noneg, mask_type, &
         maskvalues, maskvarname, -1, fraction_type, 7.5_r_std, 4._r_std, output, availability)
    call emit_real_vector(unit, label, 'output', output)
    call emit_real_vector(unit, label, 'availability', availability)
    call emit_real_vector(unit, label, 'source_values', reshape(values2, (/ size(values2) /)))
    call emit_real_vector(unit, label, 'source_lon', reshape(lon2, (/ size(lon2) /)))
    call emit_real_vector(unit, label, 'source_lat', reshape(lat2, (/ size(lat2) /)))
    call emit_trace(unit, label)
  end subroutine run_continuous

  subroutine emit_trace(unit, label)
    integer, intent(in) :: unit
    character(len=*), intent(in) :: label
    integer :: i
    call emit_integer(unit, label, 'attempt_count', 1, aggregate_attempt_count)
    do i = 1, aggregate_attempt_count
      call emit_integer(unit, label, 'attempt_width', i, aggregate_widths(i))
    end do
    call emit_integer_vector(unit, label, 'mask', reshape(captured_mask, (/ size(captured_mask) /)))
    call emit_integer_vector(unit, label, 'overlap_index', reshape(captured_index, (/ size(captured_index) /)))
    call emit_real_vector(unit, label, 'overlap_area', reshape(captured_area, (/ size(captured_area) /)))
  end subroutine emit_trace

  subroutine emit_real_vector(unit, label, field, values)
    integer, intent(in) :: unit
    character(len=*), intent(in) :: label, field
    real(r_std), intent(in) :: values(:)
    integer :: i
    do i = 1, size(values)
      write(unit,'(A,",",A,",",I0,",",ES25.16E3)') trim(label), trim(field), i, values(i)
    end do
  end subroutine emit_real_vector

  subroutine emit_integer_vector(unit, label, field, values)
    integer, intent(in) :: unit
    character(len=*), intent(in) :: label, field
    integer, intent(in) :: values(:)
    integer :: i
    do i = 1, size(values)
      call emit_integer(unit, label, field, i, values(i))
    end do
  end subroutine emit_integer_vector

  subroutine emit_integer(unit, label, field, index, value)
    integer, intent(in) :: unit, index, value
    character(len=*), intent(in) :: label, field
    write(unit,'(A,",",A,",",I0,",",I0)') trim(label), trim(field), index, value
  end subroutine emit_integer

  subroutine run_contract_mode(contract_mode)
    character(len=*), intent(in) :: contract_mode
    real(r_std) :: lalo(2,2), resolution(2,2), contfrac(2), variabletypes(3)
    real(r_std) :: output_fraction(6), output_cont(2), availability(2), maskvalues(3)
    real(r_std) :: varmin, varmax
    integer(i_std) :: neighbours(2,NbNeighb)
    integer :: rank_value, initime
    logical :: continuous
    character(len=80) :: filename, varname, lonname, latname
    character(len=250) :: maskvarname
    character(len=50) :: masktype, fraction_type
    continuous = index(contract_mode, 'cont_') == 1
    if (index(contract_mode, 'default') > 0) then
      rank_value = 1
      initime = -1
    else if (index(contract_mode, 'rank3') > 0) then
      rank_value = 3
      initime = -1
    else
      rank_value = 4
      if (index(contract_mode, 'zero') > 0) then
        initime = 0
      else if (index(contract_mode, 'selected') > 0) then
        initime = 1
      else if (index(contract_mode, 'late') > 0) then
        initime = 99
      else
        initime = -1
      end if
    end if
    call configure_fixture(3, rank_value)
    call prepare_target(0._r_std, 120000._r_std, lalo, resolution, neighbours, contfrac)
    call reset_aggregate_trace()
    printlev = 0
    variabletypes = (/ 1._r_std, 2._r_std, 3._r_std /)
    maskvalues = zero
    varmin = zero
    varmax = 3._r_std
    filename = 'fixture.nc'
    lonname = 'lon'
    latname = 'lat'
    maskvarname = 'mask'
    masktype = 'nomask'
    fraction_type = 'default'
    if (continuous) then
      varname = 'topography'
      call interpweight_2Dcont(2, 0, 0, lalo, resolution, neighbours, contfrac, &
           filename, varname, lonname, latname, varmin, varmax, rank_value > 1, masktype, &
           maskvalues, maskvarname, initime, fraction_type, 7.5_r_std, 4._r_std, output_cont, availability)
    else
      varname = 'soilcolor'
      call interpweight_2D(2, 3, variabletypes, lalo, resolution, neighbours, contfrac, &
           filename, varname, lonname, latname, varmin, varmax, rank_value > 1, masktype, &
           maskvalues, maskvarname, 0, 0, initime, fraction_type, -un, -un, output_fraction, availability)
    end if
    error stop 99
  end subroutine run_contract_mode

  subroutine run_coverage_success()
    integer, parameter :: npoint = 5
    real(r_std) :: lalo(npoint,2), resolution(npoint,2), contfrac(npoint)
    real(r_std) :: variabletypes(3), fraction_output(npoint*3), continuous_output(npoint)
    real(r_std) :: availability(npoint), maskvalues(3), varmin, varmax
    integer(i_std) :: neighbours(npoint,NbNeighb)
    character(len=80) :: filename, varname, lonname, latname
    character(len=250) :: maskvarname
    character(len=50) :: masktype, fraction_type
    call configure_fixture(3, 2)
    lalo(:,1) = zero
    lalo(:,2) = zero
    resolution = 50000._r_std
    neighbours = 0
    contfrac = un
    call configure_parallel(lalo, resolution, neighbours, contfrac)
    filename = 'fixture.nc'
    lonname = 'lon'
    latname = 'lat'
    maskvarname = 'mask'
    masktype = 'nomask'
    fraction_type = 'default'
    maskvalues = zero
    variabletypes = (/ 1._r_std, 2._r_std, 3._r_std /)
    printlev = 3
    varmin = un
    varmax = 3._r_std
    varname = 'soilcolor'
    call reset_aggregate_trace()
    call interpweight_2D(npoint, 3, variabletypes, lalo, resolution, neighbours, contfrac, &
         filename, varname, lonname, latname, varmin, varmax, .false., masktype, &
         maskvalues, maskvarname, 0, 0, -1, fraction_type, -un, -un, &
         fraction_output, availability)
    varmin = zero
    varmax = 10._r_std
    varname = 'topography'
    call reset_aggregate_trace()
    call interpweight_2Dcont(npoint, 0, 0, lalo, resolution, neighbours, contfrac, &
         filename, varname, lonname, latname, varmin, varmax, .false., masktype, &
         maskvalues, maskvarname, -1, fraction_type, 7.5_r_std, 4._r_std, &
         continuous_output, availability)
  end subroutine run_coverage_success

