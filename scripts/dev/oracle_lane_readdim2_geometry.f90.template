module readdim2_geometry_oracle
  implicit none
  integer :: numout=6, printlev_loc=0
  integer :: iim_g_begin=0, iim_g_end=0, jjm_g_begin=0, jjm_g_end=0
  integer :: iim_full=7, jjm_full=5, iim_zoom=3, jjm_zoom=3
  integer :: iim_g=7, jjm_g=5, mpi_rank=0
  integer :: i_index(3)=(/2,4,6/), j_index(3)=(/1,3,5/)
  integer :: jj_para_begin(0:0)=(/1/), jj_para_end(0:0)=(/5/)
  logical :: weathergen=.false., interpol=.true., is_root_prc=.true.
  real :: limit_west=-180., limit_east=180., limit_north=90., limit_south=-90.
  real :: merid_res=360., zonal_res=180.
  real :: lon_full(7,5), lat_full(7,5), lon_g(7,5), lat_g(7,5)
  integer :: error_count=0
  interface bcast
    module procedure bcast_real2
  end interface
contains
  subroutine ipslerr_p(level, caller, message1, message2, message3)
    integer, intent(in) :: level
    character(*), intent(in) :: caller, message1, message2, message3
    error_count=error_count+1
  end subroutine
  subroutine bcast_real2(values)
    real, intent(inout) :: values(:,:)
  end subroutine
! <FORCING_LANDIND>
! <FORCING_GRID>
! <FORCING_ZOOM>
! <DOMAIN_SIZE>
end module

program driver
  use readdim2_geometry_oracle
  implicit none
  real :: lon(7,5), lat(7,5), west, east, north, south
  real :: tair(3,3), grid_lon(3,3), grid_lat(3,3)
  integer :: iind(7), jind(5), ni, nj, i, j, k, nb, itest, jtest, kind(9), unit
  character(512) :: path
  do j=1,5
    lon(:,j)=(/-200.,-150.,-90.,0.,30.,170.,200./)
    lat(:,j)=60.-30.*(j-1)
  end do

  west=-100.; east=10.; north=40.; south=-40.; error_count=0
  call domain_size(west,east,north,south,7,5,lon,lat,ni,nj,iind,jind)
  call get_command_argument(1,path)
  open(newunit=unit,file=trim(path),status='replace'); write(unit,'(a)') 'field,flat_index,value'
  call outi(unit,'normal_counts',(/ni,nj,iim_g_begin,iim_g_end,jjm_g_begin,jjm_g_end/),6)
  call outi(unit,'normal_iind',iind,ni); call outi(unit,'normal_jind',jind,nj)

  west=100.; east=-100.; north=40.; south=-40.; error_count=0
  call domain_size(west,east,north,south,7,5,lon,lat,ni,nj,iind,jind)
  call outi(unit,'dateline_counts',(/ni,nj,iim_g_begin,iim_g_end,jjm_g_begin,jjm_g_end/),6)
  call outi(unit,'dateline_iind',iind,ni); call outi(unit,'dateline_jind',jind,nj)

  west=-100.; east=10.; north=-20.; south=20.; error_count=0
  call domain_size(west,east,north,south,7,5,lon,lat,ni,nj,iind,jind)
  call outi(unit,'invalid_lat_error',(/error_count/),1)

  tair=reshape((/20.,150.,30.,140.,40.,130.,50.,120.,60./),(/3,3/))
  call forcing_landind(3,3,tair,.false.,nb,kind,itest,jtest)
  call outi(unit,'celsius_meta',(/nb,itest,jtest/),3); call outi(unit,'celsius_kindex',kind,nb)
  tair=reshape((/280.,999999.,290.,510.,300.,520.,310.,530.,320./),(/3,3/))
  call forcing_landind(3,3,tair,.false.,nb,kind,itest,jtest)
  call outi(unit,'kelvin_meta',(/nb,itest,jtest/),3); call outi(unit,'kelvin_kindex',kind,nb)

  do j=1,5; do i=1,7
    lon_full(i,j)=-180.+30.*(i-1)+.1*j
    lat_full(i,j)=80.-20.*(j-1)+.01*i
  end do; end do
  call forcing_grid(3,3,1,grid_lon,grid_lat,.true.)
  k=0; do j=1,3; do i=1,3
    write(unit,'(a,i0,a,es25.17)') 'grid_lon,',k,',',grid_lon(i,j)
    write(unit,'(a,i0,a,es25.17)') 'grid_lat,',k,',',grid_lat(i,j); k=k+1
  end do; end do
  close(unit)
contains
  subroutine outi(u,name,values,n)
    integer,intent(in)::u,n,values(:);character(*),intent(in)::name;integer::q
    do q=1,n;write(u,'(a,a,i0,a,i0)')trim(name),',',q-1,',',values(q);enddo
  end subroutine
end program
