module defprec
 use iso_fortran_env,only:int32,real64
 implicit none;integer,parameter::i_std=int32,r_std=real64
end module
module matrix_resolution_oracle
 use defprec;implicit none
 real(r_std),parameter::zero=0._r_std,min_stomate=1.e-8_r_std
 integer,parameter::ipassive_pool=7
contains
 subroutine ipslerr_p(level,a,b,c,d)
  integer,intent(in)::level;character(*),intent(in)::a,b,c,d
  if(level>=3)error stop 'ipslerr_p'
 end subroutine
! <GAUSS_JORDAN_METHOD>
! <ERROR_L1_PASSIVE>
end module
program driver
 use defprec;use matrix_resolution_oracle;implicit none
 real(r_std)::a(3,3),b(3),a2(2,2),b2(2),cur(3,2,7),prev(3,2,7),veg(3,2)
 logical::flag(3);integer::u,i,j;character(512)::path,mode
 call get_command_argument(2,mode)
 if(trim(mode)=='singular')then;a2=zero;b2=1._r_std;call gauss_jordan_method(2,a2,b2);stop 97;endif
 a(1,:)=(/0._r_std,2._r_std,1._r_std/);a(2,:)=(/1._r_std,1._r_std,0._r_std/);a(3,:)=(/2._r_std,0._r_std,1._r_std/);b=(/7._r_std,3._r_std,5._r_std/)
 call gauss_jordan_method(3,a,b)
 a2=reshape((/2._r_std,0._r_std,0._r_std,4._r_std/),(/2,2/));b2=(/6._r_std,8._r_std/);call gauss_jordan_method(2,a2,b2)
 cur=zero;prev=zero;veg=reshape((/.25_r_std,1._r_std,.5_r_std,.75_r_std,0._r_std,.5_r_std/),(/3,2/))
 prev(:,1,7)=(/100._r_std,1.e-10_r_std,4._r_std/);prev(:,2,7)=(/20._r_std,1.e-10_r_std,6._r_std/)
 cur(:,1,7)=(/101._r_std,2.e-10_r_std,4.01_r_std/);cur(:,2,7)=(/19._r_std,3.e-10_r_std,6.01_r_std/)
 call error_l1_passive(3,2,7,cur,prev,veg,.2_r_std,flag)
 call get_command_argument(1,path);open(newunit=u,file=trim(path),status='replace');write(u,'(a)')'field,flat_index,value'
 do i=1,3;write(u,'(a,i0,a,es25.17)')'solution,',i-1,',',b(i);enddo
 do i=1,3;do j=1,3;write(u,'(a,i0,a,es25.17)')'inverse,',(i-1)*3+j-1,',',a(i,j);enddo;enddo
 do i=1,2;write(u,'(a,i0,a,es25.17)')'diag_solution,',i-1,',',b2(i);enddo
 do i=1,3;write(u,'(a,i0,a,i0)')'passive_flag,',i-1,',',merge(1,0,flag(i));enddo;close(u)
end program
