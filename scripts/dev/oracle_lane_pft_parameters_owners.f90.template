module defprec
  implicit none
  integer, parameter :: i_std=selected_int_kind(9)
  integer, parameter :: r_std=selected_real_kind(12,300)
end module defprec

module oracle_getin_state
  use defprec
  implicit none
  character(len=48), save :: oracle_mode=''
  integer(i_std), save :: getin_total=0, writeback_total=0
  integer(i_std), save :: hit_iplt1=0, hit_iplt2=0, hit_age_bound=0
  integer(i_std), save :: hit_iso_activity=0
contains
  subroutine record_key(key,changed)
    character(*), intent(in) :: key
    logical, intent(in) :: changed
    getin_total=getin_total+1
    if (changed) writeback_total=writeback_total+1
    if (trim(key)=='SP_IPLT1') hit_iplt1=hit_iplt1+1
    if (trim(key)=='SP_IPLT2') hit_iplt2=hit_iplt2+1
    if (trim(key)=='GLUC_AGE_CLASS_BOUND') hit_age_bound=hit_age_bound+1
    if (trim(key)=='ISO_ACTIVITY') hit_iso_activity=hit_iso_activity+1
  end subroutine record_key
end module oracle_getin_state

module constantes
  use defprec
  implicit none
  integer(i_std), parameter :: undef_int=999999999_i_std
  real(r_std), parameter :: undef=-9999._r_std, zero=0._r_std
  integer(i_std), parameter :: nleafages=4_i_std, nparts=12_i_std, nelements=1_i_std
  integer(i_std), save :: numout=6_i_std, printlev=0_i_std
  integer(i_std), save :: cyc_rot_max=1_i_std, nagec_tree=1_i_std, nagec_herb=1_i_std
  logical, save :: ok_sechiba=.true., ok_stomate=.true., ok_bvoc=.true.
  logical, save :: hydrol_cwrr=.false., OFF_LINE_MODE=.false.
  logical, save :: peat_hydro=.false., tides=.false., use_age_class=.false.
  logical, save :: SingleAgeClass=.false., use_bound_spa=.false.
  real(r_std), save :: iso_activity(nleafages)=(/0.5,1.5,1.5,0.5/)
  real(r_std), save :: methanol_activity(nleafages)=(/1.,1.,0.5,0.5/)
end module constantes

