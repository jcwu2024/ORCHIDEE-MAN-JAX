module defprec
  use iso_fortran_env, only:int32,real64
  implicit none
  integer,parameter::i_std=int32,r_std=real64
end module
module IOIPSL
  implicit none
  integer,parameter::numout=6
contains
  subroutine ipslerr_p(level,a,b,c,d)
    integer,intent(in)::level; character(*),intent(in)::a,b,c,d
    if(level>=3) error stop 'ipslerr_p'
  end subroutine
end module
module constantes
  use defprec
  implicit none
  real(r_std),parameter::zero=0.d0,undemi=.5d0,un=1.d0,deux=2.d0,trois=3.d0
  real(r_std),parameter::msmlr_air=28.964d-3,msmlr_h2o=18.02d-3
  real(r_std),parameter::cp_air=1004.675d0,cte_grav=9.80665d0,retv=msmlr_air/msmlr_h2o-un
  real(r_std),parameter::rvtmp2=(4.d0*msmlr_air)/(3.5d0*msmlr_h2o)-un,cepdu2=.01d0
  real(r_std),parameter::ct_karman=.41d0,cb=5.d0,cc=5.d0,cd=5.d0,tp_00=273.15d0,min_sechiba=1.d-8
  real(r_std)::min_wind=.1d0,snowcri=1.5d0,dt_sechiba=1800.d0
  real(r_std)::dew_veg_poly_coeff(6)=(/1.d0,0.d0,0.d0,0.d0,0.d0,0.d0/)
  logical::hydrol_cwrr=.true.,diag_qsat=.true.
  integer::printlev=0
end module
module constantes_soil
  implicit none
  logical::ok_snowfact=.false.,rough_dyn=.false.
end module
module pft_parameters
  implicit none
  integer,parameter::nvm=14
  logical::ok_LAIdev(nvm)=.false.
end module
module qsat_moisture
  use defprec; use constantes; use IOIPSL; use constantes_soil
  implicit none
  logical,save::l_qsat_first=.true.
  integer(i_std),parameter::max_temp=370,min_temp=100
  real(r_std),dimension(max_temp),save::qsfrict
contains
! <QSAT_PROCEDURES>
end module
module diffuco_oracle
  use defprec; use constantes; use constantes_soil; use pft_parameters; use qsat_moisture; use IOIPSL
  implicit none
  integer,parameter::nnobio=2
  real(r_std),allocatable,save::wind(:)
contains
! <DIFFUCO_PROCEDURES>
end module
program oracle_main
  use defprec; use constantes; use constantes_soil; use pft_parameters; use diffuco_oracle
  implicit none
  integer,parameter::n=3
  integer::i,j
  real(r_std)::u(n),v(n),zlev(n),z0h(n),z0m(n),rh(n),ts(n),ta(n),qsurf(n),qair(n),snow(n)
  real(r_std)::rhp(n,nvm),tsp(n,nvm),qc(n),qcp(n,nvm)
  real(r_std)::qsatt(n),rau(n),fracnb(n,2),snow_nb(n,2),fracsnv(n),fracsnn(n,2),totnb(n),vb1(n)
  real(r_std)::hum(n,nvm),veg(n,nvm),qsv(n,nvm),qsm(n,nvm),rstruct(n,nvm),vb2(n,nvm),vb23(n,nvm)
  real(r_std)::evlim(n),v3(n,nvm),v4(n),v4p(n,nvm),totbare(n),vmax(n,nvm)
  real(r_std)::lai(n,nvm),alpha(n),beta(n),betap(n,nvm),pb(n),hum0(n,nvm),v20(n,nvm),v30(n,nvm),v10(n),v40(n),v4p0(n,nvm)
  character(512)::path
  call get_command_argument(1,path); open(10,file=trim(path),status='replace'); write(10,'(a)')'field,i,j,value'
  allocate(wind(n)); u=(/.02d0,2.d0,4.d0/); v=(/0.d0,1.d0,0.d0/); wind=sqrt(u*u+v*v)
  zlev=10.d0; z0h=.1d0; z0m=.15d0; rh=1.d0; rhp=1.2d0
  ts=(/285.d0,290.d0,265.d0/); ta=(/290.d0,285.d0,270.d0/); tsp=spread(ts,2,nvm); tsp(:,14)=ts+1.d0
  qsurf=.006d0; qair=(/.005d0,.1d0,.1d0/); snow=(/0.d0,2.d0,2.d0/); ok_LAIdev=.false.; ok_LAIdev(14)=.true.
  call diffuco_aero(n,1,u,v,zlev,z0h,z0m,rh,rhp,ts,tsp,ta,qsurf,qair,snow,qc,qcp)
  do i=1,n; write(10,'(a,i0,a,i0,a,es25.17)')'aero_qc,',i,',',0,',',qc(i); do j=2,nvm; write(10,'(a,i0,a,i0,a,es25.17)')'aero_qcp,',i,',',j,',',qcp(i,j); enddo; enddo
  ok_snowfact=.true.
  call diffuco_aero(n,1,u,v,zlev,z0h,z0m,rh,rhp,ts,tsp,ta,qsurf,qair,snow,qc,qcp)
  do i=1,n; write(10,'(a,i0,a,i0,a,es25.17)')'aero_snowfact_qc,',i,',',0,',',qc(i); enddo
  ok_snowfact=.false.
  pb=1000.d0; call qsatcalc(n,ts,pb,qsatt); rau=(/1.2d0,1.1d0,1.3d0/)
  fracnb=.05d0; totnb=.1d0; snow_nb=.02d0; fracsnv=(/0.d0,.8d0,1.d0/); fracsnn=.5d0
  call diffuco_snow(n,qair,qsatt,rau,u,v,qc,snow,fracnb,totnb,snow_nb,fracsnv,fracsnn,vb1)
  do i=1,n; write(10,'(a,i0,a,i0,a,es25.17)')'snow_vb1,',i,',',0,',',vb1(i); enddo
  hum=.7d0; veg=0.d0; veg(:,14)=(/.4d0,.7d0,.8d0/); veg(1,2:3)=.2d0
  qsv=0.d0; qsv(:,14)=(/1.d-8,.2d0,.01d0/); qsv(1,2)=.1d0; qsv(1,3)=1.d-8
  qsm=.3d0; qsm(1,2)=0.d0; hum(1,3)=0.d0; rstruct=50.d0
  call diffuco_inter(n,qair,qsatt,rau,u,v,qc,qcp,hum,veg,qsv,qsm,rstruct,vb2,vb23)
  do i=1,n; do j=1,nvm; write(10,'(a,i0,a,i0,a,es25.17)')'inter_vb2,',i,',',j,',',vb2(i,j); write(10,'(a,i0,a,i0,a,es25.17)')'inter_vb23,',i,',',j,',',vb23(i,j); enddo; enddo
  evlim=(/.2d0,.4d0,.6d0/); v3=0.d0; v3(:,14)=.1d0; vmax=veg; vmax(:,1)=.2d0; vmax(:,14)=.8d0; totbare=.2d0
  call diffuco_bare(n,u,v,qc,[100._r_std,100._r_std,100._r_std],evlim,hum,veg,vmax,totbare,vb2,v3,v4,v4p)
  do i=1,n; write(10,'(a,i0,a,i0,a,es25.17)')'bare_v4,',i,',',0,',',v4(i); do j=1,nvm; write(10,'(a,i0,a,i0,a,es25.17)')'bare_v4p,',i,',',j,',',v4p(i,j); enddo; enddo
  hydrol_cwrr=.false.; totbare=(/0.d0,.2d0,.2d0/)
  call diffuco_bare(n,u,v,qc,[100._r_std,100._r_std,100._r_std],evlim,hum,veg,vmax,totbare,vb2,v3,v4,v4p)
  do i=1,n; write(10,'(a,i0,a,i0,a,es25.17)')'bare_non_cwrr_v4,',i,',',0,',',v4(i); enddo
  hydrol_cwrr=.true.; totbare=.2d0
  call diffuco_bare(n,u,v,qc,[100._r_std,100._r_std,100._r_std],evlim,hum,veg,vmax,totbare,vb2,v3,v4,v4p)
  lai=1.d0; qsm=0.d0; qsm(:,14)=.3d0; hum0=hum; v20=vb2; v30=v3; v10=vb1; v40=v4; v4p0=v4p
  call diffuco_comb(n,hum,rau,u,v,qc,pb,qair,ts,ta,snow,veg,vmax,lai,totbare,vb1,vb2,v3,v4,v4p,alpha,beta,betap,qsm)
  do i=1,n
    write(10,'(a,i0,a,i0,a,es25.17)')'comb_alpha,',i,',',0,',',alpha(i); write(10,'(a,i0,a,i0,a,es25.17)')'comb_beta,',i,',',0,',',beta(i)
    write(10,'(a,i0,a,i0,a,es25.17)')'comb_vb1,',i,',',0,',',vb1(i); write(10,'(a,i0,a,i0,a,es25.17)')'comb_vb4,',i,',',0,',',v4(i)
    do j=1,nvm
      write(10,'(a,i0,a,i0,a,es25.17)')'comb_betap,',i,',',j,',',betap(i,j); write(10,'(a,i0,a,i0,a,es25.17)')'comb_vb2,',i,',',j,',',vb2(i,j)
      write(10,'(a,i0,a,i0,a,es25.17)')'comb_vb3,',i,',',j,',',v3(i,j); write(10,'(a,i0,a,i0,a,es25.17)')'comb_hum,',i,',',j,',',hum(i,j)
    enddo
  enddo
  hum=hum0; vb2=v20; v3=v30; vb1=v10; v4=v40; v4p=v4p0
  alpha=0.d0; beta=0.d0; betap=0.d0; qsm=0.d0; qsm(:,14)=.3d0
  qsm(2,13)=.3d0; lai=1.d0; lai(2,13)=0.d0; lai(2,14)=2.d0; totbare=(/.2d0,0.d0,.2d0/)
  call diffuco_comb(n,hum,rau,u,v,qc,pb,qair,ts,ta,snow,veg,vmax,lai,totbare,vb1,vb2,v3,v4,v4p,alpha,beta,betap,qsm)
  do i=1,n
    write(10,'(a,i0,a,i0,a,es25.17)')'comb2_alpha,',i,',',0,',',alpha(i); write(10,'(a,i0,a,i0,a,es25.17)')'comb2_beta,',i,',',0,',',beta(i)
    write(10,'(a,i0,a,i0,a,es25.17)')'comb2_vb1,',i,',',0,',',vb1(i); write(10,'(a,i0,a,i0,a,es25.17)')'comb2_vb4,',i,',',0,',',v4(i)
    do j=1,nvm
      write(10,'(a,i0,a,i0,a,es25.17)')'comb2_betap,',i,',',j,',',betap(i,j); write(10,'(a,i0,a,i0,a,es25.17)')'comb2_vb2,',i,',',j,',',vb2(i,j)
      write(10,'(a,i0,a,i0,a,es25.17)')'comb2_vb3,',i,',',j,',',v3(i,j); write(10,'(a,i0,a,i0,a,es25.17)')'comb2_hum,',i,',',j,',',hum(i,j)
    enddo
  enddo
  close(10)
end program
