module defprec
 implicit none
 integer,parameter::i_std=kind(1),r_std=kind(1.0)
end module
module enerbil_parameters
 use defprec
 implicit none
 real(r_std),parameter::zero=0d0,un=1d0,cp_air=1004.675d0
end module
module enerbil_oracle
