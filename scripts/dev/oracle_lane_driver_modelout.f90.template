program driver_modelout_oracle
  implicit none
  integer,parameter::npts=2,nvm=14,nparts=12,nelements=1,icarbon=1
  integer,parameter::ileaf=1,isapabove=2,isapbelow=3,iheartabove=4,iheartbelow=5,iroot=6,ifruit=7,icarbres=8,iagrsapst=9,iagrsappn=10,iagrhrtst=11,iagrhrtpn=12
  integer::unit,i,j
  real::biomass(npts,nvm,nparts,nelements),npp_daily(npts,nvm),gpp_daily(npts,nvm)
  real::ind(npts,nvm),cn_ind(npts,nvm),woodmass_ind(npts,nvm),moiavail_week(npts,nvm),tot_live_biomass(npts,nvm,nelements)
  biomass=0.; do j=1,nparts; do i=1,npts; biomass(i,14,j,1)=100*j+i; end do; end do
  npp_daily=0.; gpp_daily=0.; npp_daily(:,14)=[3.,4.]; gpp_daily(:,14)=[5.,6.]
  ind=0.;cn_ind=0.;woodmass_ind=0.;moiavail_week=0.;tot_live_biomass=0.
  open(newunit=unit,file=trim(command_argument()),status='replace',action='write')
! <MODELOUT_XIOS_SPAN>
  close(unit)
contains
  subroutine xios_orchidee_send_field(name,value)
    character(len=*),intent(in)::name; real,intent(in)::value(:,:); integer::ii,jj
    do jj=1,size(value,2); do ii=1,size(value,1)
      write(unit,'(A,",",ES26.17E3)') trim(name),value(ii,jj)
    end do; end do
  end subroutine
  function command_argument() result(value)
    character(len=1024)::value; call get_command_argument(1,value)
  end function
end program
