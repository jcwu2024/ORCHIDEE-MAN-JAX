module defprec
 implicit none
 integer,parameter::i_std=kind(1),r_std=kind(1d0)
end module
module constantes
 use defprec
 implicit none
 real(r_std),parameter::zero=0d0,un=1d0,pi=3.1415926535897932384626433832795d0,min_stomate=0d0,large_value=1d33
 real(r_std)::pipe_density=2d5,pipe_tune1=100d0,pipe_tune2=40d0,pipe_tune3=.5d0,pipe_tune_exp_coeff=1.6d0,bm_sapl_rescale=40d0
 logical::ok_dgvm=.false.,lpj_gap_const_mort=.true.
 character(len=80)::stom_restname_in='NONE'
 integer::numout=6
end module
module stomate_data
 use defprec
 implicit none
 integer,parameter::nvm=14,nparts=12,nelements=1,nleafages=4
 integer,parameter::ileaf=1,isapabove=2,isapbelow=3,iheartabove=4,iheartbelow=5,iroot=6,ifruit=7,icarbres=8,iagrsapst=9,iagrsappn=10,iagrhrtst=11,iagrhrtpn=12,icarbon=1
 real(r_std)::bm_sapl(nvm,nparts,nelements)
end module
module pft_parameters
 use defprec
 implicit none
 logical::natural(14),pasture(14),is_tree(14)
 real(r_std)::maxdia(14)
 character(len=8)::pheno_model(14)
end module
module prescribe_oracle
 use stomate_data;use pft_parameters;use constantes
 implicit none
 logical,save::firstcall_prescribe=.true.
contains
! <PRESCRIBE_PROCEDURE>
end module
program main
 use defprec;use stomate_data;use pft_parameters;use constantes;use prescribe_oracle
 implicit none
 integer::u,caseid,i,j,k,m
 character(len=1024)::out
 real(r_std)::veg(3,nvm),every(3,nvm),wg(3,nvm),bio(3,nvm,nparts,nelements),frac(3,nvm,nleafages),ind(3,nvm),cn(3,nvm),co2(3,nvm)
 logical::present(3,nvm)
 call get_command_argument(1,out)
 natural=.false.;pasture=.false.;is_tree=.false.;natural(14)=.true.;is_tree(14)=.true.;maxdia=.5d0;pheno_model='none'
 do j=1,nvm;do k=1,nparts;bm_sapl(j,k,1)=dble(k);end do;end do
 open(newunit=u,file=trim(out),status='replace',action='write');write(u,'(A)')'field,value'
 do caseid=1,4
  veg=0d0;every=0d0;wg=0d0;bio=0d0;frac=0d0;ind=0d0;cn=0d0;co2=0d0;present=.false.
  natural=.false.;pasture=.false.;is_tree=.false.;natural(14)=.true.
  if(caseid<=2)then
   veg(:,14)=(/.8d0,.4d0,0d0/);is_tree(14)=.true.
   if(caseid==1)then
    stom_restname_in='NONE';firstcall_prescribe=.true.
   else
    stom_restname_in='restart.nc';firstcall_prescribe=.true.
   endif
  else
   ! These firstcall-false matrix cases isolate prescribed crown/density arms.
   firstcall_prescribe=.false.;stom_restname_in='restart.nc'
   if(caseid==3)then
    ! Positive high wood, positive low wood, and zero cover cover tree arms.
    veg(:,14)=(/.8d0,.4d0,0d0/);is_tree(14)=.true.
    bio(1,14,isapabove,1)=1d4;bio(1,14,isapbelow,1)=1d4
    bio(1,14,iheartabove,1)=1d4;bio(1,14,iheartbelow,1)=1d4
    bio(2,14,isapabove,1)=1d3;bio(2,14,isapbelow,1)=1d3
    bio(2,14,iheartabove,1)=1d3;bio(2,14,iheartbelow,1)=1d3
   else
    ! The canonical grass WHERE arms require a non-tree prescribed PFT14.
    veg(:,14)=(/.8d0,0d0,.4d0/)
   endif
  endif
  call prescribe(3,veg,1d0,present,every,wg,bio,frac,ind,cn,co2)
  do j=1,nvm;do i=1,3
   if(caseid==1)then
    write(u,'(A,",",ES26.17)')'cold_present',merge(1d0,0d0,present(i,j));write(u,'(A,",",ES26.17)')'cold_everywhere',every(i,j);write(u,'(A,",",ES26.17)')'cold_ind',ind(i,j);write(u,'(A,",",ES26.17)')'cold_cn',cn(i,j);write(u,'(A,",",ES26.17)')'cold_co2',co2(i,j)
   else if(caseid==2)then
    write(u,'(A,",",ES26.17)')'restart_present',merge(1d0,0d0,present(i,j));write(u,'(A,",",ES26.17)')'restart_everywhere',every(i,j);write(u,'(A,",",ES26.17)')'restart_ind',ind(i,j);write(u,'(A,",",ES26.17)')'restart_cn',cn(i,j);write(u,'(A,",",ES26.17)')'restart_co2',co2(i,j)
   else if(caseid==3)then
    write(u,'(A,",",ES26.17)')'tree_present',merge(1d0,0d0,present(i,j));write(u,'(A,",",ES26.17)')'tree_everywhere',every(i,j);write(u,'(A,",",ES26.17)')'tree_ind',ind(i,j);write(u,'(A,",",ES26.17)')'tree_cn',cn(i,j);write(u,'(A,",",ES26.17)')'tree_co2',co2(i,j)
   else
    write(u,'(A,",",ES26.17)')'grass_present',merge(1d0,0d0,present(i,j));write(u,'(A,",",ES26.17)')'grass_everywhere',every(i,j);write(u,'(A,",",ES26.17)')'grass_ind',ind(i,j);write(u,'(A,",",ES26.17)')'grass_cn',cn(i,j);write(u,'(A,",",ES26.17)')'grass_co2',co2(i,j)
   endif
   do k=1,nparts
    if(caseid==1)then;write(u,'(A,",",ES26.17)')'cold_biomass',bio(i,j,k,1);else if(caseid==2)then;write(u,'(A,",",ES26.17)')'restart_biomass',bio(i,j,k,1);else if(caseid==3)then;write(u,'(A,",",ES26.17)')'tree_biomass',bio(i,j,k,1);else;write(u,'(A,",",ES26.17)')'grass_biomass',bio(i,j,k,1);endif
   end do
   do m=1,nleafages
    if(caseid==1)then;write(u,'(A,",",ES26.17)')'cold_leaf_frac',frac(i,j,m);else if(caseid==2)then;write(u,'(A,",",ES26.17)')'restart_leaf_frac',frac(i,j,m);else if(caseid==3)then;write(u,'(A,",",ES26.17)')'tree_leaf_frac',frac(i,j,m);else;write(u,'(A,",",ES26.17)')'grass_leaf_frac',frac(i,j,m);endif
   end do
  end do;end do
 end do;close(u)
end program
