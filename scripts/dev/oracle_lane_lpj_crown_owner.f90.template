module lpj_crown_oracle
  use iso_fortran_env,only:int32,real64
  implicit none
  integer,parameter::i_std=int32,r_std=real64,nvm=14,nparts=12,nelements=1
  real(r_std),parameter::zero=0._r_std,un=1._r_std,min_stomate=0._r_std,pi=acos(-1._r_std)
  real(r_std)::pipe_density=2.e5_r_std,pipe_tune1=100._r_std,pipe_tune2=40._r_std,pipe_tune3=.5_r_std,pipe_tune_exp_coeff=1.6_r_std
  real(r_std)::maxdia(nvm)=.5_r_std,height_presc(nvm)=10._r_std
  logical::ok_dgvm=.true.,lpj_gap_const_mort=.true.,is_tree(nvm)=.false.,natural(nvm)=.true.
contains
  subroutine ipslerr_p(level,caller,m1,m2,m3)
    integer,intent(in)::level;character(*),intent(in)::caller,m1,m2,m3
    if(level>=3)error stop 'ipslerr_p'
  end subroutine
! <CROWN>
end module
program driver
  use lpj_crown_oracle
  implicit none
  logical::present(2,nvm);real(r_std)::ind(2,nvm),biomass(2,nvm,nparts,nelements),wood(2,nvm),veget(2,nvm),cn(2,nvm),height(2,nvm)
  integer::unit,i,j,k;character(512)::path,mode
  call get_command_argument(1,path);call get_command_argument(2,mode)
  if(trim(mode)=='fatal')then;ok_dgvm=.false.;call crown(2,present,ind,biomass,wood,veget,cn,height);stop;endif
  present=.false.;ind=1._r_std;biomass=0._r_std;wood=0._r_std;veget=.2_r_std;height=3._r_std
  is_tree=.false.;is_tree(2)=.true.;natural=.true.;maxdia=.5_r_std
  present(1,2)=.true.;present(2,2)=.true.;wood(1,2)=20000._r_std;wood(2,2)=0._r_std
  present(1,14)=.true.;present(2,14)=.false.
  call crown(2,present,ind,biomass,wood,veget,cn,height)
  open(newunit=unit,file=trim(path),status='replace');write(unit,'(a)')'field,flat_index,value';k=0
  do i=1,2;do j=1,nvm
    write(unit,'(a,i0,a,es25.17)')'cn_ind,',k,',',cn(i,j)
    write(unit,'(a,i0,a,es25.17)')'height,',k,',',height(i,j)
    write(unit,'(a,i0,a,es25.17)')'veget_max,',k,',',veget(i,j);k=k+1
  enddo;enddo;close(unit)
end program
